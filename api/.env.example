# Work directory for job files
WORK_DIR=./work

# Ghidra installation path
GHIDRA_HOME=/opt/ghidra

# Port
PORT=3000

# Analysis timeout in milliseconds (5 minutes)
ANALYSIS_TIMEOUT_MS=300000

# Maximum queue depth
MAX_QUEUE_DEPTH=10

# Job retention in milliseconds (1 hour)
JOB_RETENTION_MS=3600000

# Maximum functions to export from Ghidra
MAX_GHIDRA_FUNCTIONS=20
